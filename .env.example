# Dataset Paths
INDONESIAN_CSV=./data/indonesian_youtube_comments.csv
ENGLISH_CSV=./data/english_youtube_comments.csv

# Model Configuration
MODEL_NAME=bert-base-multilingual-cased
MAX_LENGTH=256

# Training Hyperparameters
BATCH_SIZE=16
LEARNING_RATE=2e-5
WEIGHT_DECAY=0.01
DROPOUT_RATE=0.1
EPOCHS=5
WARMUP_RATIO=0.1
PATIENCE=1

# Data Split Configuration
RANDOM_SEED=42
N_SPLITS=5

# Output Directory
OUTPUT_DIR=./model_output

# Hyperparameter Tuning Ranges (for Optuna)
LR_MIN=1e-5
LR_MAX=5e-5

WEIGHT_DECAY_MIN=0.0
WEIGHT_DECAY_MAX=0.1

DROPOUT_RATE_MIN=0.1
DROPOUT_RATE_MAX=0.3

WARMUP_RATIO_MIN=0.0
WARMUP_RATIO_MAX=0.35
